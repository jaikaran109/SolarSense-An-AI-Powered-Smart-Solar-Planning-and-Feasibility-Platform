# ==========================================
# SolarSense Platform Environment Variables
# ==========================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# CORS Allowed Origins (Comma-separated for production domains)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,https://solarsense.in,https://solar-sense-theta.vercel.app

# MongoDB Connection String (Atlas or Local)
# If left commented or unavailable, backend automatically uses resilient in-memory storage
MONGODB_URI=mongodb://localhost:27017/solarsense

# Frontend API Base URL (backend origin only; client adds /api automatically)
VITE_API_URL=http://localhost:5000

# Google Gemini API Key (Optional - for real LLM chat assistant, has intelligent contextual fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Mapbox Public Token (Optional - has high-res satellite & canvas fallback)
VITE_MAPBOX_TOKEN=pk.eyJ1IjoiZXhhbXBsZXVzZXIiLCJhIjoiY2xleGFtcGxlMDAwMDAwMHoxMm5zZXBsZSJ9.example
